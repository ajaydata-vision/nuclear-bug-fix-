#!/usr/bin/env bash

set -euo pipefail

SKILL_NAME="nuclear-bug-fix"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="${SCRIPT_DIR}"
INSTALLER="${REPO_ROOT}/scripts/install.py"

usage() {
  cat <<'EOF'
Usage: ./setup [--personal|--project] [--install-dir PATH]

If the repo is already located at ~/.claude/skills/nuclear-bug-fix or
.claude/skills/nuclear-bug-fix, setup verifies the install and exits.
Otherwise it copies the current checkout into the selected Claude skills path.
EOF
}

scope="personal"
scope_mode="auto"
install_dir=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --personal)
      scope="personal"
      scope_mode="personal"
      ;;
    --project)
      scope="project"
      scope_mode="project"
      ;;
    --install-dir)
      if [[ $# -lt 2 ]]; then
        echo "error: --install-dir requires a path" >&2
        exit 1
      fi
      install_dir="$2"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "error: unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
  shift
done

if [[ ! -f "${REPO_ROOT}/SKILL.md" ]]; then
  echo "error: setup must be run from the repo root containing SKILL.md" >&2
  exit 1
fi

python_bin=""
if command -v python3 >/dev/null 2>&1; then
  python_bin="python3"
elif command -v python >/dev/null 2>&1; then
  python_bin="python"
else
  echo "error: python3 or python is required" >&2
  exit 1
fi

current_dir="$(cd "${REPO_ROOT}" && pwd -P)"
current_name="$(basename "${current_dir}")"
parent_name="$(basename "$(dirname "${current_dir}")")"
invocation_dir="$(pwd -P)"
personal_target="$("${python_bin}" -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "${HOME}/.claude/skills/${SKILL_NAME}")"
current_is_installed="false"
if [[ "${current_name}" == "${SKILL_NAME}" ]] && [[ "${parent_name}" == "skills" ]]; then
  current_is_installed="true"
fi

requested_target=""
if [[ -n "${install_dir}" ]]; then
  requested_target="$("${python_bin}" -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "${install_dir}")"
elif [[ "${scope_mode}" == "auto" ]]; then
  if [[ "${current_is_installed}" == "true" ]]; then
    requested_target="${current_dir}"
  else
    requested_target="${personal_target}"
  fi
elif [[ "${scope}" == "personal" ]]; then
  requested_target="${personal_target}"
else
  if [[ "${current_is_installed}" == "true" ]] && [[ "${current_dir}" != "${personal_target}" ]]; then
    requested_target="${current_dir}"
  else
    case "${invocation_dir}/" in
      "${current_dir}/"* )
        echo "error: --project from a personal install must be run from the target project root or with --install-dir" >&2
        exit 1
        ;;
    esac
    requested_target="$("${python_bin}" -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "${invocation_dir}/.claude/skills/${SKILL_NAME}")"
  fi
fi

if [[ "${current_dir}" == "${requested_target}" ]]; then
  echo "nuclear-bug-fix is already installed at ${current_dir}"
  echo "Restart Claude Code if it is already running."
  exit 0
fi

cmd=("${python_bin}" "${INSTALLER}" --repo-root "${REPO_ROOT}" --install-dir "${requested_target}")

"${cmd[@]}"
